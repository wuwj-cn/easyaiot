{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "run.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--port",
                "29101"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Python: Run Script",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}